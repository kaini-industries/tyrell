#!/usr/bin/env python3
"""Compatibility entry point for Sandline, a Tyrell Game Framework consumer."""
from pathlib import Path
import subprocess
import sys

if __name__ == '__main__':
    script = Path(__file__).resolve().with_name('game')
    raise SystemExit(subprocess.run([sys.executable, str(script), '--project', 'tanks', *sys.argv[1:]]).returncode)
