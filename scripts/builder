#!/usr/bin/env python3
"""Manage Tyrell's isolated ARM64 Lima VM; never connect to the handheld."""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import runpy
import re
import shutil
import subprocess
import sys
import tarfile
import uuid

ROOT = Path(__file__).resolve().parents[1]
STATE = ROOT / 'build'
INSTANCE = 'tyrell-build'
GUEST_INPUT = '/var/tmp/tyrell-input'
GUEST_OUTPUT = '/var/tmp/tyrell-build/artifacts'
ENV = os.environ.copy()
ENV['LIMA_HOME'] = str(STATE / 'lima')


def run(args, **kwargs):
    return subprocess.run(args, check=True, env=ENV, **kwargs)


def lima(*args, **kwargs):
    return run(['limactl', *args], **kwargs)


def guest(*args, **kwargs):
    return lima('shell', '--workdir=/tmp', INSTANCE, *args, **kwargs)


def inputs(app='status'):
    locked = json.loads((ROOT / 'locks/build-inputs.json').read_text())
    if app == 'video':
        locked.update(json.loads((ROOT / 'locks/video-build-inputs.json').read_text()))
    elif app != 'status':
        raise RuntimeError('Unknown application: ' + app)
    return locked


def digest(path):
    h = hashlib.sha256()
    with path.open('rb') as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b''):
            h.update(chunk)
    return h.hexdigest()


def require_space(path, needed, purpose):
    available = shutil.disk_usage(path).free
    reserve = 128 * 1024**2
    if available < needed + reserve:
        raise RuntimeError(f'{purpose} needs {(needed + reserve) / 1024**2:.0f} MiB free '
                           f'on {path}; only {available / 1024**2:.0f} MiB is available')


def fetch():
    source = inputs()['lvgl']
    expected = source['sha256']
    if not expected or len(expected) != 64:
        raise RuntimeError('LVGL archive must have a locked SHA-256 before fetching')
    archive = STATE / 'downloads' / ('lvgl-' + source['commit'] + '.tar.gz')
    archive.parent.mkdir(parents=True, exist_ok=True)
    if archive.exists():
        if digest(archive) != expected:
            raise RuntimeError('Cached LVGL archive checksum mismatch; preserve it for inspection')
        return archive
    partial = archive.with_suffix('.partial')
    try:
        run(['curl', '--fail', '--location', '--retry', '2', '--connect-timeout', '15',
             '--output', str(partial), source['url']])
        if digest(partial) != expected:
            raise RuntimeError('Downloaded LVGL checksum mismatch')
        partial.replace(archive)
    finally:
        partial.unlink(missing_ok=True)
    return archive


def shared_lock():
    return runpy.run_path(str(ROOT / 'image/build_lock.py'))['builder_lock'](ROOT)


def instance_state():
    result = lima('list', INSTANCE, '--format', '{{.Status}} {{.Memory}}',
                  stdout=subprocess.PIPE, text=True)
    fields = result.stdout.strip().split()
    if len(fields) != 2:
        raise RuntimeError('Cannot determine builder state and memory')
    return fields[0], int(fields[1])


def assert_guest_idle():
    """Fail before replacing inputs when a detached image owns this builder."""
    try:
        result = guest('systemctl', 'show', 'tyrell-image-build.service', '-p', 'LoadState',
                       '-p', 'ActiveState', '-p', 'SubState',
                       stdout=subprocess.PIPE, text=True)
        output = result.stdout
    except subprocess.CalledProcessError as error:
        output = error.stdout or ''
    state = dict(line.split('=', 1) for line in output.splitlines() if '=' in line)
    if state.get('ActiveState') in {'activating', 'active', 'deactivating', 'reloading'} \
            and state.get('SubState') != 'exited':
        raise RuntimeError('An image build is running; use scripts/builder image status or wait')
    if state.get('LoadState') not in {'loaded', 'not-found'}:
        raise RuntimeError('Cannot determine whether an image build is active')
    # Create with normal-user ownership before root systemd jobs use this file.
    guest('mkdir', '-p', '-m', '700', '/var/tmp/tyrell-locks')
    guest('touch', '/var/tmp/tyrell-locks/builder.lock')
    guest('flock', '-n', '/var/tmp/tyrell-locks/builder.lock', 'true')


def image_dependencies():
    dependencies = (ROOT / 'builder/image-dependencies.txt').read_text().splitlines()
    if not dependencies or len(set(dependencies)) != len(dependencies) \
            or any(not re.fullmatch(r'[a-z0-9][a-z0-9+.-]*', value) for value in dependencies):
        raise RuntimeError('Invalid canonical image dependency list')
    return dependencies


def render_lima_template():
    """Render the canonical dependency list into first-boot provisioning."""
    template = (ROOT / 'builder/lima.yaml').read_text()
    marker = '      # TYRELL_IMAGE_DEPENDENCIES'
    if template.count(marker) != 1:
        raise RuntimeError('Lima template must contain exactly one image dependency marker')
    rendered = template.replace(marker, '      apt-get install -y --no-install-recommends '
                                + ' '.join(image_dependencies()))
    destination = STATE / 'builder-template.yaml'
    destination.write_text(rendered)
    return destination


def up():
    STATE.mkdir(exist_ok=True)
    instance_config = STATE / 'lima' / INSTANCE / 'lima.yaml'
    memory = os.environ.get('TYRELL_BUILDER_MEMORY')
    resource_api = runpy.run_path(str(ROOT / 'image/resources.py'))
    resource_api['host_preflight'](ROOT)
    amount = resource_api['memory_mib'](memory) if memory is not None else None
    if instance_config.exists():
        # A template edit must not silently resize an existing builder.
        if amount is not None:
            status, current = instance_state()
            if current != amount * 1024 ** 2:
                if status != 'Stopped':
                    raise RuntimeError('Stop the builder before changing TYRELL_BUILDER_MEMORY')
                resource_api['check_memory_capacity'](amount)
                lima('edit', '--tty=false', '--memory=' + str(amount / 1024), INSTANCE)
        lima('start', '--tty=false', INSTANCE)
    else:
        resource_api['check_memory_capacity'](amount or 4096)
        options = ['--memory=' + str(amount / 1024)] if amount is not None else []
        lima('start', '--name=' + INSTANCE, '--tty=false', *options, str(render_lima_template()))


def image_deps(check_only=False):
    """Provision/check tools explicitly, under both shared build locks."""
    with shared_lock():
        up()
        assert_guest_idle()
        image_dependencies()  # Validate before transferring root-executed input.
        destination = '/var/tmp/tyrell-image-deps-' + uuid.uuid4().hex
        guest('mkdir', '-m', '700', destination)
        files = ['ensure-image-deps.sh', 'image-dependencies.txt']
        expected = {}
        for name in files:
            path = ROOT / 'builder' / name
            if path.is_symlink() or not path.is_file():
                raise RuntimeError('Unsafe image provisioning input: ' + str(path))
            expected[name] = digest(path)
            lima('copy', '--backend=scp', str(path), INSTANCE + ':' + destination + '/' + name)
        guest('python3', '-c',
              "import hashlib,json,pathlib,sys; p=pathlib.Path(sys.argv[1]); expected=json.loads(sys.argv[2]); "
              "assert all(hashlib.sha256((p/n).read_bytes()).hexdigest()==h for n,h in expected.items()), 'Provisioning input changed'",
              destination, json.dumps(expected))
        guest('sudo', '-n', 'flock', '-n', '/var/tmp/tyrell-locks/builder.lock',
              'bash', destination + '/ensure-image-deps.sh', '--check' if check_only else 'install')


def bundle(app='status'):
    archive = fetch()
    locked = inputs(app)
    selected = []
    bases = [ROOT / ('packages/' + locked['package']), ROOT / 'builder', ROOT / 'locks']
    if app in {'status', 'video'}:
        common = ROOT / 'packages/tyrell-app-common'
        if common.is_symlink() or not (common / 'CMakeLists.txt').is_file():
            raise RuntimeError('Missing shared application source')
        bases.append(common)
    for base in bases:
        for path in sorted(base.rglob('*')):
            if '__pycache__' in path.parts or path.suffix in {'.pyc', '.pyo'} or path.name == '.DS_Store':
                continue
            if path.is_symlink():
                raise RuntimeError('Symlinks are not allowed in builder inputs: ' + str(path))
            if path.is_file():
                if path.name.startswith('.env'):
                    raise RuntimeError('Credential file is not a build input')
                selected.append(path)
    selected.append(ROOT / 'scripts/builder')
    if app == 'video':
        for name in ['video-fixtures.py', 'video-matrix.py', 'video-inventory.py']:
            path = ROOT / 'scripts' / name
            if path.is_symlink() or not path.is_file():
                raise RuntimeError('Missing or unsafe video validation tool: ' + str(path))
            selected.append(path)
    if not any(p.name == 'CMakeLists.txt' for p in selected):
        raise RuntimeError('Application CMakeLists.txt is missing')
    source_files = {str(p.relative_to(ROOT)): digest(p) for p in selected}
    source_hash = hashlib.sha256(json.dumps(source_files, sort_keys=True).encode()).hexdigest()
    metadata = {
        'application': app, 'package': locked['package'],
        'version': locked['version'], 'debian_version': locked['version'] + '-1',
        'source_revision': 'src-' + source_hash[:12],
        'source_sha256': source_hash, 'source_files': source_files,
        'source_date_epoch': locked['source_date_epoch'],
        'device_access': 'None: build inputs do not include .env or device credentials.',
    }
    metadata_path = STATE / 'source-manifest.json'
    metadata_path.write_text(json.dumps(metadata, indent=2) + '\n')
    tar_path = STATE / 'builder-input.tar'
    # This archive is a generated transfer, not a source cache. Reclaim any
    # interrupted transfer before checking space; never unpack LVGL on the host.
    tar_path.unlink(missing_ok=True)
    estimated_size = archive.stat().st_size + sum(path.stat().st_size + 4096 for path in selected) + 1024**2
    require_space(STATE, estimated_size, 'The source transfer')
    try:
        with tarfile.open(tar_path, 'w') as tar:
            for path in selected:
                tar.add(path, arcname=str(path.relative_to(ROOT)), recursive=False)
            tar.add(metadata_path, arcname='source-manifest.json')
            tar.add(archive, arcname='downloads/' + archive.name)
    except BaseException:
        tar_path.unlink(missing_ok=True)
        raise
    return tar_path


def publish_artifacts(staging, destination, app):
    """Replace one app's export, retaining the other app and a rollback copy."""
    if destination.is_symlink():
        raise RuntimeError('Refusing to replace a symlinked artifacts directory')
    preserved = destination / 'video' if app == 'status' else None
    if preserved is not None and preserved.is_symlink():
        raise RuntimeError('Refusing to move a symlinked video artifacts directory')
    previous = None
    if destination.exists():
        stamp = datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')
        previous = STATE / ('previous-' + app + '-artifacts-' + stamp)
        destination.rename(previous)
    destination.parent.mkdir(parents=True, exist_ok=True)
    try:
        if preserved is not None and previous is not None and (previous / 'video').exists():
            (previous / 'video').rename(staging / 'video')
        staging.rename(destination)
    except OSError:
        if previous is not None:
            if preserved is not None and (staging / 'video').exists():
                (staging / 'video').rename(previous / 'video')
            previous.rename(destination)
        raise


def build(app='status'):
    with shared_lock():
        _build_locked(app)


def _build_locked(app='status'):
    up()
    assert_guest_idle()
    tar_path = bundle(app)
    guest('python3', '-c', "import shutil; from pathlib import Path; p=Path('/var/tmp/tyrell-input'); shutil.rmtree(p, ignore_errors=True); p.mkdir()")
    try:
        lima('copy', '--backend=scp', str(tar_path), INSTANCE + ':/var/tmp/tyrell-input.tar')
    finally:
        # Release the approximately 97 MiB LVGL transfer before the VM builds.
        tar_path.unlink(missing_ok=True)
    guest('tar', '-xf', '/var/tmp/tyrell-input.tar', '-C', GUEST_INPUT)
    guest('bash', GUEST_INPUT + '/builder/build-package.sh', GUEST_INPUT)
    output_tar = STATE / 'artifacts.tar'
    output_tar.unlink(missing_ok=True)
    sizes = guest('python3', '-c', "from pathlib import Path; print(sum(p.stat().st_size + 4096 for p in Path('/var/tmp/tyrell-build/artifacts').rglob('*') if p.is_file()))",
                  stdout=subprocess.PIPE, text=True)
    require_space(STATE, 2 * int(sizes.stdout.strip()) + 1024**2, 'Artifact transfer and extraction')
    try:
        with output_tar.open('wb') as stream:
            guest('tar', '-C', GUEST_OUTPUT, '-cf', '-', '.', stdout=stream)
    except BaseException:
        output_tar.unlink(missing_ok=True)
        raise
    destination = ROOT / 'artifacts' if app == 'status' else ROOT / 'artifacts/video'
    if (ROOT / 'artifacts').is_symlink():
        raise RuntimeError('Refusing to export through a symlinked artifacts directory')
    if destination.is_symlink():
        raise RuntimeError('Refusing to replace a symlinked artifacts directory')
    staging = STATE / 'exported-artifacts'
    if staging.exists():
        shutil.rmtree(staging)
    staging.mkdir()
    with tarfile.open(output_tar) as tar:
        for member in tar.getmembers():
            path = staging / member.name
            if member.issym() or member.islnk() or not path.resolve().is_relative_to(staging.resolve()):
                raise RuntimeError('Unsafe artifact archive path: ' + member.name)
            if not member.isfile() and not member.isdir():
                raise RuntimeError('Unexpected artifact type: ' + member.name)
        tar.extractall(staging, filter='data')
    for line in (staging / 'SHA256SUMS').read_text().splitlines():
        expected, name = line.split('  ', 1)
        path = staging / name
        if not path.resolve().is_relative_to(staging.resolve()) or digest(path) != expected:
            raise RuntimeError('Exported artifact checksum mismatch: ' + name)
    publish_artifacts(staging, destination, app)
    output_tar.unlink(missing_ok=True)
    print('Artifacts copied to ' + str(destination))


def parse_args(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    parser = argparse.ArgumentParser(description=__doc__)
    actions = parser.add_subparsers(dest='action', required=True)
    for name in ['up', 'info', 'stop', 'fetch']:
        actions.add_parser(name)
    app_build = actions.add_parser('build')
    app_build.add_argument('--app', choices=['status', 'video'], default='status')
    actions.add_parser('image-deps').add_argument('--check', action='store_true')
    for name in ['image', 'shell', 'zero']:
        actions.add_parser(name).add_argument('command', nargs=argparse.REMAINDER)
    # These commands own their option parsing; preserve their complete order.
    if argv and argv[0] in {'image', 'shell', 'zero'}:
        return argparse.Namespace(action=argv[0], command=argv[1:])
    return parser.parse_args(argv)


def main():
    args = parse_args()
    if args.action == 'zero':
        # Host-only inspection works without Lima; the package command checks
        # its own VM requirements and never routes through the app installer.
        run([sys.executable, str(ROOT / 'builder/zero.py'), *args.command])
        return
    if not shutil.which('limactl'):
        raise RuntimeError('Install Lima 2.x before using this builder')
    if args.action == 'up':
        with shared_lock():
            up()
    elif args.action == 'info':
        lima('list')
    elif args.action == 'stop':
        with shared_lock():
            status, _ = instance_state()
            if status == 'Running':
                assert_guest_idle()
            elif status != 'Stopped':
                raise RuntimeError('Cannot stop a builder in state ' + status)
            lima('stop', INSTANCE)
    elif args.action == 'fetch':
        print(fetch())
    elif args.action == 'build':
        build(args.app)
    elif args.action == 'image-deps':
        image_deps(args.check)
    elif args.action == 'image':
        run([sys.executable, str(ROOT / 'image/build-image.py'), *args.command])
    elif args.action == 'shell':
        guest(*(args.command or ['bash']))


if __name__ == '__main__':
    try:
        main()
    except (RuntimeError, OSError, subprocess.CalledProcessError) as error:
        print('builder: ' + str(error), file=sys.stderr)
        sys.exit(1)
