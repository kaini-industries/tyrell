{
  "schema": 1,
  "profile": "tyrell-zero",
  "activation": "image-only-after-complete-integration-qualification",
  "default_target": "multi-user.target",
  "requires_target": "tyrell-zero.target",
  "mask_system_units": ["greetd.service", "getty@tty1.service", "getty@tty7.service", "LaunchWizard.service", "applaunch-updater.service", "applaunch-apps-updater.service", "userconfig.service"],
  "mask_user_units": ["APPLaunch.service"],
  "logind_dropin_source": "/usr/share/tyrell-zero/profile/logind.conf",
  "logind_dropin_destination": "/etc/systemd/logind.conf.d/90-tyrell-zero.conf",
  "package_installation_activates_profile": false,
  "foundation_is_release_ready": false
}
