#!/bin/sh
set -e
case "$1" in
    remove)
        deb-systemd-helper mask tyrell-video-hdmi.socket >/dev/null || true
        ;;
    purge)
        deb-systemd-helper purge tyrell-video-hdmi.socket >/dev/null || true
        deb-systemd-helper unmask tyrell-video-hdmi.socket >/dev/null || true
        ;;
esac
if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
fi
