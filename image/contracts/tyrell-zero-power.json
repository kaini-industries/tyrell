{
  "schema": 1,
  "id": "tyrell-zero-power",
  "plan_revision": 3,
  "default_preset": "baseline",
  "package": "tyrell-zero-power-policy",
  "selection_config": "/etc/tyrell-zero/power-policy.json",
  "selection_schema": {
    "schema": 1,
    "preset": "baseline"
  },
  "activation_implemented": false,
  "qualification": "not-tested-for-Zero",
  "presets": {
    "baseline": {
      "ethernet_control": "on",
      "ethernet_autosuspend_delay_ms": 2000,
      "ondemand_sampling_down_factor": 50
    },
    "ethernet": {
      "ethernet_control": "auto",
      "ethernet_autosuspend_delay_ms": 2000,
      "ondemand_sampling_down_factor": 50
    },
    "cpu": {
      "ethernet_control": "on",
      "ethernet_autosuspend_delay_ms": 2000,
      "ondemand_sampling_down_factor": 1
    },
    "combined": {
      "ethernet_control": "auto",
      "ethernet_autosuspend_delay_ms": 2000,
      "ondemand_sampling_down_factor": 1
    }
  },
  "baseline_controls": {
    "governor": "ondemand",
    "cpu_min_khz": 600000,
    "cpu_max_khz": 1000000,
    "ondemand_tunables": {
      "up_threshold": 50,
      "ignore_nice_load": 0,
      "powersave_bias": 0,
      "sampling_rate": 100000,
      "io_is_busy": 0,
      "sampling_down_factor": 50
    },
    "ethernet_parent_policy": "auto",
    "wifi_power_save": "preserve-effective-on-and-explicit-user-choice",
    "ethernet_eee": "preserve-enabled",
    "gpu_mem_mib": 128,
    "cma_mib": 64,
    "swap": "preserve"
  },
  "ethernet_match": {
    "vendor_id": "0fe6",
    "product_id": "9900",
    "usb_device_driver": "r8152-cfgselector",
    "interface_driver": "r8152",
    "integrated_board_topology_required": true,
    "hardcoded_bus_number_allowed": false,
    "wakeup_attribute": "record-availability-and-value"
  },
  "conditional_search": {
    "cpu_factors": [
      2,
      5
    ],
    "ethernet_delays_ms": [
      5000
    ],
    "trigger": "Only after unresolved or failing battery/performance/churn evidence; bounded one-change trials with new captured identity."
  },
  "runtime_override": "/run/tmpfiles.d/raspberrypi-sys-mods-ondemand-governor.conf",
  "safety": {
    "install_sysfs_writes": false,
    "install_udev_triggers": false,
    "polling_daemon": false,
    "eligibility_before_optimized_write": true,
    "transactional_invalidation": true,
    "restore_live_and_boot_policy": true
  },
  "release_gates": {
    "battery_promotion_required": true,
    "usb_only_promotion_allowed": false,
    "hardware_and_performance_required": true,
    "combined_independent_battery_proof_required": true,
    "raw_gauge_correction_allowed": false,
    "claims_require_explicit_reference": true,
    "all_gates": "future-unexecuted"
  }
}
